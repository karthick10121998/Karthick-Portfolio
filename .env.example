# Analytics Configuration (Umami)
# Get these values from your Umami analytics dashboard
VITE_ANALYTICS_ENDPOINT=https://your-umami-instance.com
VITE_ANALYTICS_WEBSITE_ID=your-website-id

# Optional: Forge API (for storage features)
# Only needed if you're using the storage proxy feature
BUILT_IN_FORGE_API_URL=https://your-forge-api.example.com
BUILT_IN_FORGE_API_KEY=your-api-key

# Node Environment (automatically set by Vercel)
NODE_ENV=production

# Port (automatically set by Vercel)
# PORT=3000
